nu X(emergencyMode: Bool = false).
 [pressButton(emergency).true*.switchOffXray(arm2)] X(true)
&& [releaseButton(emergency)] X(false)
&& forall a:Arm.forall dirJ:JoystickDirection 
. (val(!emergencyMode) => [true*.moveArmJoystick(a, dirJ)]<true*.rotateArm(a, translateJoystickToArmRotation(dirJ))>true)

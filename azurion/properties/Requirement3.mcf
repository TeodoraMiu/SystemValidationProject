nu X(
	patientOnTable: Bool = false,
	operationOngoing: Bool = false,
	emergencyMode: Bool = false,
	XrayOnArm1: Bool = false,
	XrayOnArm2: Bool = false) .
[pressButton(stop)] X(patientOnTable, false, emergencyMode, XrayOnArm1, XrayOnArm2)
&& [pressButton(emergency)] X(patientOnTable, false, true, XrayOnArm1, XrayOnArm2)
&& [releaseButton(emergency)] X(patientOnTable, operationOngoing, false, XrayOnArm1, XrayOnArm2)
&& [weightSensorOn] X(true, operationOngoing, emergencyMode, XrayOnArm1, XrayOnArm2)
&& [weightSensorOff] X(false, false, emergencyMode, XrayOnArm1, XrayOnArm2)
&& (val(!emergencyMode && patientOnTable) => [pressButton(start)]X(patientOnTable, true, emergencyMode, XrayOnArm1, XrayOnArm2))
&& (val(patientOnTable && operationOngoing && !emergencyMode)=> ([true* .weightSensorOff]mu Y. ([!switchOffXray(arm1)] Y && <true>true)))
&& (val(patientOnTable && operationOngoing && !emergencyMode)=> ([true* .weightSensorOff]mu Z. ([!switchOffXray(arm2)] Z && <true>true)))
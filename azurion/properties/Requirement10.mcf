% if any atBoundary action happens, we need to make sure that the arm/table stops moving
nu Y(
    TableMoveStopped: Bool = false,
    Arm1MoveStopped: Bool = false,
    Arm2MoveStopped: Bool = false,
    Arm1RotateStopped: Bool = false,
    Arm2RotateStopped: Bool = false
).
[stopMoveTable] Y(true, Arm1MoveStopped, Arm2MoveStopped, Arm1RotateStopped, Arm2RotateStopped)
&& [stopMoveArm(arm1)] Y(TableMoveStopped, true, Arm2MoveStopped, Arm1RotateStopped, Arm2RotateStopped)
&& [stopMoveArm(arm2)] Y(TableMoveStopped, Arm1MoveStopped, true, Arm1RotateStopped, Arm2RotateStopped)
&& [stopRotateArm(arm2)] Y(TableMoveStopped, Arm1MoveStopped, Arm2MoveStopped, true, Arm2RotateStopped)
&& [stopRotateArm(arm2)] Y(TableMoveStopped, Arm1MoveStopped, Arm2MoveStopped, Arm1RotateStopped, true)
&& forall dirT: TableDirection. [moveTable(dirT)] Y(false, Arm1MoveStopped, Arm2MoveStopped, Arm1RotateStopped, Arm2RotateStopped)
&& forall dirA: ArmDirection. [moveArm(arm1, dirA)] Y(TableMoveStopped, false, Arm2MoveStopped, Arm1RotateStopped, Arm2RotateStopped)
&& forall dirA: ArmDirection. [moveArm(arm2, dirA)] Y(TableMoveStopped, Arm1MoveStopped, false, Arm1RotateStopped, Arm2RotateStopped)
&& forall rotA: ArmRotation. [rotateArm(arm1, rotA)] Y(TableMoveStopped, Arm1MoveStopped, Arm2MoveStopped, false, Arm2RotateStopped)
&& forall rotA: ArmRotation. [rotateArm(arm2, rotA)] Y(TableMoveStopped, Arm1MoveStopped, Arm2MoveStopped, Arm1RotateStopped, false)
&& (val(!TableMoveStopped) => [true* . atBoundaryPositionTable] mu X. ([!stopMoveTable] X && <true>true))
&& (val(!Arm1MoveStopped) => [true* . atBoundaryPositionArm(arm1)] mu X. ([stopMoveArm(arm1)] X && <true>true))
&& (val(!Arm2MoveStopped) => [true* . atBoundaryPositionArm(arm2)] mu X. ([stopMoveArm(arm2)] X && <true>true))
&& (val(!Arm1RotateStopped) => [true* . atBoundaryRotationArm(arm1)] mu X. ([stopRotateArm(arm1)] X && <true>true))
&& (val(!Arm2RotateStopped) => [true* . atBoundaryRotationArm(arm2)] mu X. ([stopRotateArm(arm2)] X && <true>true))
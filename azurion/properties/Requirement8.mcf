nu X(emergencyMode: Bool = false).
    [pressButton(emergency)] X(true)
    && [releaseButton(emergency)] X(false)
    && (val(emergencyMode)
    => (forall dirT:TableDirection. [true*.moveTable(dirT)]false 
        && forall a:Arm. forall dirA: ArmDirection. [true*.moveArm(a, dirA)]false 
        && forall a:Arm. forall rotA: ArmRotation. [true*.rotateArm(a, rotA)]false))
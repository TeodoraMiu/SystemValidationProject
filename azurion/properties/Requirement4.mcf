nu X(
	patientOnTable: Bool = false,
	TableMoveStopped: Bool = true) .
[weightSensorOn] X(true, TableMoveStopped)
&& [weightSensorOff] X(false, TableMoveStopped)
&& forall dirT: TableDirection. [moveTable(dirT)] X(patientOnTable, false)
&& [stopMoveTable] X(patientOnTable, true)
&& (val(!TableMoveStopped) => [true* .weightSensorOn]mu Y. ([!stopMoveTable] Y && <true>true))
nu X(
	patientOnTable: Bool = false,
	operationOngoing: Bool = false,
	emergencyMode: Bool = false,
	stopMoveTable: Bool = true) . 
[pressButton(stop)] X(patientOnTable, false, emergencyMode, stopMoveTable)
&& [pressButton(emergency)] X(patientOnTable, false, true, stopMoveTable)
&& [releaseButton(emergency)] X(patientOnTable, operationOngoing, false, stopMoveTable)
&& [weightSensorOn] X(true, operationOngoing, emergencyMode, stopMoveTable)
&& [weightSensorOff] X(false, operationOngoing, emergencyMode, stopMoveTable)
&& (val(!emergencyMode && patientOnTable) 
	=> [pressButton(start)]X(patientOnTable, true, emergencyMode, stopMoveTable))
&& forall dirT: TableDirection. [moveTable(dirT)] X(patientOnTable, operationOngoing, emergencyMode, false)
&& [stopMoveTable] X(patientOnTable, operationOngoing, emergencyMode, true)
&& (val(operationOngoing) => forall dirT: TableDirection.[true.moveTable(dirT)]false)
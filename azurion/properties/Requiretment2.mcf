nu X( XrayOnArm1: Bool = false, XrayOnArm2: Bool = false ).
	[switchOnXray(arm1)]X (true, XrayOnArm2)
	&& ([switchOnXray(arm2)]X (XrayOnArm1, true))
	&& (forall p:Pedal.(val(if(translatePedaltoArm(p) == arm1, XrayOnArm1, XrayOnArm2)) => ([true*. releasePedal(p)]mu Y.([!switchOffXray(translatePedaltoArm(p))] Y && <true>true))))
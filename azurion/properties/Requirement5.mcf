nu X(
    XrayOnArm1: Bool = false, XrayOnArm2: Bool = false).
[switchOnXray(arm1)]X (true, XrayOnArm2)
&& ([switchOnXray(arm2)]X (XrayOnArm1, true))
&& (val(XrayOnArm1)=> ([true* . pressButton(emergency)]mu Y. ([!switchOffXray(arm1)] Y && <true>true)))
&& (val(XrayOnArm2)=> ([true*.pressButton(emergency)]mu Z. ([!switchOffXray(arm2)] Z && <true>true)))
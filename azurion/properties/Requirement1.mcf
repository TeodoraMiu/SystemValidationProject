nu X(
    patientOnTable: Bool = false,
    operationOngoing: Bool = false,
    emergencyMode: Bool = false,
    XRayOnArm1: Bool = false, 
    XRayOnArm2: Bool = false).
(val(!emergencyMode && patientOnTable) => [pressButton(start)] X(patientOnTable, true, emergencyMode, XRayOnArm1, XRayOnArm2)) 
&& [pressButton(stop)] X(patientOnTable, false, emergencyMode, XRayOnArm1, XRayOnArm2)
&& [pressButton(emergency)] X(patientOnTable, false, true, XRayOnArm1, XRayOnArm2)
&& [releaseButton(emergency)] X(patientOnTable, operationOngoing, false, XRayOnArm1, XRayOnArm2)
&& [weightSensorOn] X(true, operationOngoing, emergencyMode, XRayOnArm1, XRayOnArm2)
&& [weightSensorOff] X(false, operationOngoing, emergencyMode, XRayOnArm1, XRayOnArm2)
&& forall arm:Arm. 
    ([switchOnXray(arm)] X (patientOnTable, operationOngoing, emergencyMode, if((arm == arm1), true, XRayOnArm1), if((arm == arm2), true, XRayOnArm2))
    && [switchOffXray(arm)] X (patientOnTable, operationOngoing, emergencyMode, if((arm == arm1), false, XRayOnArm1), if((arm == arm2), false, XRayOnArm2)))
&& (val(!emergencyMode && operationOngoing && patientOnTable) => 
    (forall p:Pedal.
        ( 
            val(if((translatePedaltoArm(p) == arm1), !XRayOnArm1, !XRayOnArm2)) =>
            (
                [true*.pressPedal(p).true*.!pressButton(stop)*.true*.!weightSensorOff*.true*.!pressButton(emergency)*]mu Y.([!switchOnXray(translatePedaltoArm(p))]Y && <true>true)
            )
        )
    )  
)